# General
NODE_ENV=development
SESSION_SECRET=""

# Docker / self-hosting
# Public hostname served by Caddy. Use a real domain in production, e.g. arcpay.example.com.
APP_DOMAIN=localhost
# Direct localhost-only app port for health checks/debugging; Caddy serves public HTTP(S).
APP_PORT=3000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Circle
CIRCLE_API_KEY=""
CIRCLE_ENTITY_SECRET=""
CIRCLE_WALLETSET_ID=""

# Arc Facilitator
ARC_FACILITATOR_WALLET_PRIVATE_KEY=""

# Redis
# For local development outside Docker, use the Redis HTTP proxy exposed by compose.yaml.
# The Docker app service overrides KV_REST_API_URL to http://redis_http_proxy.
KV_REST_API_URL="http://localhost:6380"
KV_REST_API_TOKEN="srhtoken"

# SendGrid
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="no-reply@arcpay.ai"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Unosend
UNOSEND_API_KEY=""
UNOSEND_FROM_EMAIL="no-reply@login.arcpay.ai"

# Slack
SLACK_BOT_TOKEN=""

# Guide (OpenAI Agent Builder)
GUIDE_OPENAI_BUILDER_WALLET_MCP_VIDEO_URL="https://aytriaddnpoidwhr.public.blob.vercel-storage.com/oai_ab_wallet-Xecs4ZDXcZAWMcnyxzcQvWdiLRyPO8.mp4"
GUIDE_OPENAI_BUILDER_SHOPPING_MCP_VIDEO_URL="https://aytriaddnpoidwhr.public.blob.vercel-storage.com/oai_ab_shopping-Osgv0mlGtglr9Gv8kk7XB5yzd5go1K.mp4"
GUIDE_OPENAI_BUILDER_INSTRUCTIONS_VIDEO_URL="https://aytriaddnpoidwhr.public.blob.vercel-storage.com/oai_ab_instructions-wk8Gpr4O7YVBCoXzvK6iBMSo6K8SRz.mp4"

# Features
FEATURE_INITIAL_FUNDING_ENABLED=false
FEATURE_INITIAL_FUNDING_AMOUNT_USDC=50
FEATURE_INITIAL_FUNDING_MAX_USE_COUNT=50
FEATURE_INITIAL_FUNDING_BLOCKCHAIN=arc
FEATURE_INITIAL_FUNDING_BLOCKCHAIN_PRIVATEKEY=

