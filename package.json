{
  "name": "arc-pay",
  "type": "module",
  "private": true,
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch development.ts",
    "build": "tsc && tsc-alias -f",
    "start": "node dist/development.js",
    "compose:dev": "docker compose up -d redis redis_http_proxy",
    "compose:prod": "npm run compose:prod:up",
    "compose:prod:up": "docker compose up -d --build",
    "compose:prod:down": "docker compose down",
    "compose:prod:recreate": "docker compose up -d --build --force-recreate",
    "compose:prod:logs": "docker compose logs -f",
    "compose:down": "npm run compose:prod:down",
    "compose:logs": "npm run compose:prod:logs",
    "mcp:inspect": "npx @modelcontextprotocol/inspector --config mcp.json",
    "arc:send-money": "tsx scripts/send-money.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.0.1",
    "@circle-fin/bridge-kit": "^1.2.0",
    "@circle-fin/developer-controlled-wallets": "^9.2.0",
    "@hono/mcp": "^0.1.4",
    "@hono/node-server": "^1.19.14",
    "@hono/session": "^0.2.0",
    "@hono/zod-validator": "^0.7.4",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@sendgrid/mail": "^8.1.6",
    "@slack/web-api": "^7.14.0",
    "@upstash/redis": "^1.35.6",
    "@x402/core": "^2.2.0",
    "@x402/evm": "^2.2.0",
    "@x402/fetch": "^2.2.0",
    "big.js": "^7.0.1",
    "currency-codes": "^2.2.0",
    "dotenv": "^17.2.3",
    "hono": "^4.9.12",
    "iso-3166-1-alpha-2": "^1.0.2",
    "libphonenumber-js": "^1.12.25",
    "nanoid": "^5.1.6",
    "twilio": "^5.10.4",
    "uuid": "^13.0.0",
    "viem": "^2.38.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.17.2",
    "@types/big.js": "^6.2.2",
    "@types/iso-3166-1-alpha-2": "^1.0.2",
    "@types/node": "^20.11.17",
    "@types/uuid": "^10.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
